:80 {
	# Reverse proxy embed sandbox to the backend container
	handle /embed/* {
		reverse_proxy backend:3000
	}

	# Reverse proxy API traffic to the backend container
	# flush_interval -1 disables response buffering so SSE progress
	# streams flush immediately without filling proxy buffers.
	handle /api/* {
		reverse_proxy backend:3000 {
			flush_interval -1
		}
	}

	# Default fallback for SPA static assets
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
