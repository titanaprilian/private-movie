{
  "name": "@repo/contracts",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "openapi:generate": "bun scripts/generate-openapi.ts",
    "openapi:check": "bun scripts/generate-openapi.ts && git diff --exit-code -- openapi/mvp-media.openapi.json"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "bun-types": "^1.4.2",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
