{
  "name": "@repo/media-service",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:integration": "node --env-file=../../apps/backend/.env.test ./node_modules/.bin/vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/lib-storage": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1126.0",
    "@repo/db": "workspace:*",
    "@repo/media-scraper": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "@vitest/coverage-v8": "3.2.7",
    "bun-types": "^1.4.2",
    "fast-check": "^4.10.2",
    "postgres": "^3.4.9",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
