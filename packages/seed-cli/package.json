{
  "name": "@repo/seed-cli",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "seed": "bun src/index.ts",
    "db:seed": "bun src/index.ts",
    "seed:tmdb": "bun --env-file=../../.env src/seed-tmdb.ts",
    "db:seed-tmdb": "bun --env-file=../../.env src/seed-tmdb.ts",
    "sync:episodes": "bun --env-file=../../.env src/sync-tmdb-episodes.ts",
    "db:sync-episodes": "bun --env-file=../../.env src/sync-tmdb-episodes.ts",
    "scrape:otakudesu": "bun src/scrape-otakudesu.ts",
    "db:scrape-otakudesu": "bun src/scrape-otakudesu.ts",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/media-scraper": "workspace:*",
    "@repo/media-service": "workspace:*",
    "cheerio": "^1.0.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "bun-types": "latest",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
