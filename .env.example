# Backend
DATABASE_URL=postgres://postgres:root_password@localhost:5432/private_movie
# Required in production — backend refuses to start without a real secret.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
HOST=0.0.0.0
PORT=3000
# Optional: direct-upload size limit in MB (default 1024)
# MAX_UPLOAD_SIZE_MB=1024
CORS_ORIGIN=http://localhost:5173,http://192.168.1.10:5173
# CORS_ORIGIN is comma-separated — add every origin that should reach the API
# (e.g. http://localhost:5173 for local dev, http://192.168.1.10:5173 for LAN)

# Web
# NOTE: baked into the image at `docker build` time — changing it requires rebuilding web.
VITE_API_URL=http://localhost:3000
# For LAN access set VITE_API_URL=http://<your-lan-ip>:3000 and rebuild (Vite inlines at build time)
# Optional: upload UI hint in MB (should match MAX_UPLOAD_SIZE_MB)
# VITE_MAX_UPLOAD_SIZE_MB=1024

# TMDB
TMDB_API_KEY=your_tmdb_bearer_token_here

# S3 / Backblaze B2 Object Storage (Optional)
# S3-compatible credentials for direct video uploads & playback streaming
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=private-movie-storage
S3_ACCESS_KEY_ID=your_backblaze_key_id
S3_SECRET_ACCESS_KEY=your_backblaze_application_key
# Optional: presigned GET playback URL expiration in seconds (default 21600 = 6 hours)
S3_PRESIGNED_GET_EXPIRES_IN=21600
# Optional: storage quota in GB shown in the dashboard (unset = unlimited)
# S3_STORAGE_LIMIT_GB=100
# REQUIRED when S3 credentials are stored: AES-256-GCM key, exactly 64 hex
# characters (32 bytes). Generate once with `openssl rand -hex 32` and NEVER
# change it afterwards — stored credentials cannot be decrypted with a new key.
# If unset/invalid, the app silently falls back to a public test key.
STORAGE_ENCRYPTION_KEY=your_64_hex_char_key_here

# MinIO Object Storage (Optional, managed by the backend orchestrator)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# Optional: ports and console URL (defaults 9000 / 9001)
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MINIO_CONSOLE_URL=http://localhost:9001
# MINIO_API_CORS_ALLOW_ORIGINS=*

# Compose host port mapping (Optional, production .env.docker)
# BACKEND_HOST_PORT=3000
# WEB_HOST_PORT=80
