# Backend
DATABASE_URL=postgres://postgres:root_password@localhost:5432/private_movie
JWT_SECRET=change-me
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://192.168.1.10:5173
# CORS_ORIGIN is comma-separated — add every origin that should reach the API
# (e.g. http://localhost:5173 for local dev, http://192.168.1.10:5173 for LAN)

# Web
VITE_API_URL=http://localhost:3000
# For LAN access set VITE_API_URL=http://<your-lan-ip>:3000 and rebuild (Vite inlines at build time)

# TMDB
TMDB_API_KEY=your_tmdb_bearer_token_here