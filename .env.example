# Backend
DATABASE_URL=postgres://postgres:root_password@localhost:5432/private_movie
JWT_SECRET=change-me
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://192.168.1.10:5173
# CORS_ORIGIN is comma-separated — add every origin that should reach the API
# (e.g. http://localhost:5173 for local dev, http://192.168.1.10:5173 for LAN)

# Web
VITE_API_URL=http://localhost:3000
# For LAN access set VITE_API_URL=http://<your-lan-ip>:3000 and rebuild (Vite inlines at build time)

# TMDB
TMDB_API_KEY=your_tmdb_bearer_token_here

# S3 / Backblaze B2 Object Storage (Optional)
# S3-compatible credentials for direct video uploads & playback streaming
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=private-movie-storage
S3_ACCESS_KEY_ID=your_backblaze_key_id
S3_SECRET_ACCESS_KEY=your_backblaze_application_key
# Optional: presigned GET playback URL expiration in seconds (default 21600 = 6 hours)
S3_PRESIGNED_GET_EXPIRES_IN=21600
