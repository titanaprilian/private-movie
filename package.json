{
  "name": "monorepo-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14 <2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "turbo run start",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@repo/backend",
    "dev:web": "turbo run dev --filter=@repo/web",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:web": "turbo run test --filter=@repo/web",
    "test:backend": "turbo run test --filter=@repo/backend",
    "test:android-tv": "turbo run test --filter=@repo/android-tv",
    "test:media-service": "turbo run test --filter=@repo/media-service",
    "test:media-service:integration": "turbo run test:integration --filter=@repo/media-service",
    "test:media-service:mutation": "turbo run test:mutation --filter=@repo/media-service",
    "test:media-scraper": "turbo run test --filter=@repo/media-scraper",
    "test:db": "turbo run test --filter=@repo/db",
    "test:contracts": "turbo run test --filter=@repo/contracts",
    "test:integration": "turbo run test:integration",
    "test:mutation": "turbo run test:mutation --filter=@repo/media-service",
    "test:mutation:all": "turbo run test:mutation:all --filter=@repo/media-service",
    "test:e2e": "bun run test/e2e/fixtures/seed.ts && playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:generate": "cd packages/db && bun run db:generate",
    "db:push": "cd packages/db && bun run db:push",
    "db:migrate": "cd packages/db && bun run db:migrate",
    "db:seed": "cd packages/db && bun run db:seed",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "verify": "turbo run typecheck lint --filter=!@repo/android-tv --continue",
    "verify:android": "turbo run typecheck lint --filter=@repo/android-tv",
    "lint:staged": "lint-staged",
    "scope:check": "bash scripts/check-commit-scope.sh",
    "check:docs": "bun scripts/doc-link-check.ts",
    "measure:ci": "bun scripts/measure-ci.ts",
    "test:gate": "vitest run test/unit/scripts/",
    "gate:check": "bun scripts/gate-check.ts",
    "gate:knip": "knip",
    "gate:jscpd": "jscpd --config .jscpd.json",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "postgres": "^3.4.9",
    "prettier": "^3.6.2",
    "turbo": "^2.5",
    "vitest": "^3.1.0"
  },
  "overrides": {
    "tinypool": "^2.1.2"
  }
}
