# Postgres Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root_password
POSTGRES_DB=private_movie

# Backend Service
DATABASE_URL=postgres://postgres:root_password@db:5432/private_movie
JWT_SECRET=docker-local-secret-key-change-in-prod
# Comma-separated list — add LAN origins if you access the API directly
# e.g. CORS_ORIGIN=http://localhost,http://192.168.1.10,http://192.168.1.10:5173
CORS_ORIGIN=http://localhost
HOST=0.0.0.0
NODE_ENV=production
PORT=3000

# Web Service
VITE_API_URL=
