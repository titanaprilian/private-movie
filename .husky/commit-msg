#!/usr/bin/env bash
# Blocks multi-app commits without authorization trailers, and forbids quality gate baselines (L5).
msg_file="$1"

git_path() { git rev-parse --git-path "$1"; }
if [ -d "$(git_path rebase-merge)" ] \
  || [ -d "$(git_path rebase-apply)" ] \
  || [ -f "$(git_path CHERRY_PICK_HEAD)" ] \
  || [ -f "$(git_path REVERT_HEAD)" ]; then
  exit 0
fi

# 1. Baseline files are retired in Level L5 (reject any attempt to add or reintroduce them)
has_baseline=$(git diff --cached --name-only --diff-filter=AM \
  | grep -E '^\.(knip|jscpd)-baseline\.json$' || true)
if [ -n "$has_baseline" ]; then
  cat >&2 <<EOF
✖ Commit blocked: quality gate baselines (.knip-baseline.json or .jscpd-baseline.json) are retired in Level L5 Zero-Tolerance mode.
Baselines are no longer permitted in this repository.
EOF
  exit 1
fi

# 2. Multi-app commit check
count=$(git diff --cached --name-only \
  | sed -nE 's#^apps/(web|backend|android-tv)/.*#\1#p' | sort -u | grep -c . || true)
if [ "$count" -gt 1 ]; then
  if ! grep -qE '^Multi-App: .+' "$msg_file"; then
    cat >&2 <<EOF
✖ Commit blocked: this commit touches multiple apps but has no authorization trailer.

Add a trailer naming the grant you were given, e.g.:

  Multi-App: #748 — contract, endpoint and UI must land atomically

Never write this trailer without an explicit go-ahead from the human owning the work.
EOF
    exit 1
  fi
fi

exit 0
