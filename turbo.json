{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["LOG_LEVEL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "@repo/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".tanstack/**"],
      "env": ["VITE_API_URL"]
    },
    "@repo/android-tv#typecheck": {
      "dependsOn": ["^build"]
    },
    "@repo/android-tv#lint": {
      "dependsOn": ["@repo/android-tv#typecheck"]
    },
    "@repo/android-tv#test": {
      "dependsOn": ["@repo/android-tv#lint"]
    },
    "@repo/android-tv#build": {
      "dependsOn": ["^build", "@repo/android-tv#test"],
      "outputs": ["app/build/outputs/**"],
      "env": ["BACKEND_API_URL"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:mutation": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:mutation:all": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@repo/backend#test:integration": {
      "dependsOn": ["^build", "test:coverage"],
      "env": ["DATABASE_URL", "JWT_SECRET"],
      "cache": false
    },
    "@repo/media-service#test:integration": {
      "dependsOn": ["^build", "test:coverage"],
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "MEDIA_SERVICE_TEST_DATABASE_URL"
      ],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["DATABASE_URL", "JWT_SECRET", "VITE_API_URL", "PORT", "CI"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:migrate": {
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "db:seed": {
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "dev": {
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "DATABASE_URL",
        "JWT_SECRET",
        "VITE_API_URL",
        "TMDB_API_KEY"
      ]
    },
    "start": {
      "persistent": true,
      "dependsOn": ["build"],
      "passThroughEnv": [
        "PORT",
        "DATABASE_URL",
        "JWT_SECRET",
        "VITE_API_URL",
        "TMDB_API_KEY"
      ]
    }
  }
}
