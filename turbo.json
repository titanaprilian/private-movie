{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "@repo/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".tanstack/**"],
      "env": ["VITE_API_URL"]
    },
    "@repo/android-tv#typecheck": {
      "dependsOn": ["^build"]
    },
    "@repo/android-tv#lint": {
      "dependsOn": ["@repo/android-tv#typecheck"]
    },
    "@repo/android-tv#test": {
      "dependsOn": ["@repo/android-tv#lint"]
    },
    "@repo/android-tv#build": {
      "dependsOn": ["^build", "@repo/android-tv#test"],
      "outputs": ["app/build/outputs/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@repo/backend#test:integration": {
      "dependsOn": ["^build", "test"],
      "env": ["DATABASE_URL", "JWT_SECRET"],
      "cache": false
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:migrate": {
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "db:seed": {
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "db:sync-episodes": {
      "env": ["DATABASE_URL", "TMDB_API_KEY"],
      "cache": false
    },
    "dev": {
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "DATABASE_URL",
        "JWT_SECRET",
        "VITE_API_URL",
        "TMDB_API_KEY"
      ]
    },
    "start": {
      "persistent": true,
      "dependsOn": ["build"],
      "passThroughEnv": [
        "PORT",
        "DATABASE_URL",
        "JWT_SECRET",
        "VITE_API_URL",
        "TMDB_API_KEY"
      ]
    }
  }
}
